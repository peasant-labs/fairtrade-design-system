{
  "name": "@peasant-labs/fairtrade",
  "private": false,
  "version": "0.0.14",
  "description": "Fairtrade design-system library: canonical tokens, base styles, component CSS, and React UI exports.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/peasant-labs/fairtrade-design-system"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    "./ui": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/ui.js",
      "require": "./dist/lib/ui.js",
      "default": "./dist/lib/ui.js"
    },
    "./graph": {
      "types": "./dist/lib/types/graph/index.d.ts",
      "import": "./dist/lib/graph.js",
      "require": "./dist/lib/graph.js",
      "default": "./dist/lib/graph.js"
    },
    "./commons": {
      "types": "./dist/lib/types/commons/index.d.ts",
      "import": "./dist/lib/commons.js",
      "require": "./dist/lib/commons.js",
      "default": "./dist/lib/commons.js"
    },
    "./analytics": {
      "types": "./dist/lib/types/analytics/index.d.ts",
      "import": "./dist/lib/analytics.js",
      "require": "./dist/lib/analytics.js",
      "default": "./dist/lib/analytics.js"
    },
    "./icons": {
      "types": "./dist/lib/types/icons.d.ts",
      "import": "./dist/lib/icons.js",
      "require": "./dist/lib/icons.js",
      "default": "./dist/lib/icons.js"
    },
    "./tokens.css": "./dist/lib/tokens.css",
    "./base.css": "./dist/lib/base.css",
    "./components.css": "./dist/lib/components.css",
    "./graph.css": "./dist/lib/graph.css",
    "./commons.css": "./dist/lib/commons.css",
    "./analytics.css": "./dist/lib/analytics.css",
    "./tokens.json": "./dist/lib/tokens.json",
    "./fonts.css": "./dist/lib/fonts.css"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "contrast": "node scripts/contrast.mjs",
    "llm": "node scripts/gen-llm-artifacts.mjs",
    "test:package-provenance": "node scripts/assert-package-provenance.mjs && node scripts/package-provenance.test.mjs",
    "test:release-guard": "node --test scripts/release-guard.test.mjs",
    "prebuild:lib": "pnpm test:release-guard",
    "gen:check": "node scripts/gen-llm-artifacts.mjs && git diff --exit-code public/tokens.json public/components.json packages/tokens/tokens.css packages/tokens/tokens.json packages/tokens/base.css packages/tokens/fonts.css",
    "build:app": "node scripts/gen-llm-artifacts.mjs && node scripts/contrast.mjs && vite build",
    "test:contract": "tsc -p tsconfig.contract.json",
    "test:runtime-floor": "node scripts/runtime-floor.test.mjs",
    "test:code-map-state": "node scripts/code-map-state.test.mjs",
    "test:code-map-ranking": "node scripts/code-map-ranking.test.mjs",
    "test:code-map-ranking:mutations": "node scripts/code-map-ranking.mutations.mjs",
    "test:code-map-ranking:bench": "node scripts/code-map-ranking-bench.mjs",
    "test:timeline-encoding-channels": "node scripts/timeline-encoding-channels.test.mjs",
    "test:timeline-highlight": "node scripts/timeline-highlight.test.mjs",
    "test:timeline-a11y": "node scripts/timeline-a11y.test.mjs",
    "test:timeline-rendered": "node scripts/timeline-rendered-probe.mjs",
    "test:timeline-session-route:mutations": "node scripts/timeline-session-route.mutations.mjs",
    "test:timeline-ghosts": "node scripts/timeline-ghosts.test.mjs",
    "test:insight-panel": "node scripts/insight-panel.test.mjs",
    "test:code-map-interactions": "node scripts/code-map-interactions.test.mjs",
    "test:code-map-drag-smoothness": "node scripts/code-map-drag-smoothness.test.mjs",
    "test:code-map-wheel-zoom": "node scripts/code-map-wheel-zoom.test.mjs",
    "test:code-map-descent-feedback": "node scripts/code-map-descent-feedback.test.mjs",
    "test:timeline-navigation": "node scripts/timeline-navigation.test.mjs",
    "test:transcript-initial-position": "node scripts/transcript-initial-position.test.mjs",
    "test:transcript-initial-position:render": "node scripts/transcript-initial-position.render.test.mjs",
    "test:transcript-initial-position:mutations": "node scripts/transcript-initial-position.mutations.mjs",
    "test:explore-page-intent": "node scripts/explore-page-intent.render.test.mjs",
    "test:explore-page-intent:mutations": "node scripts/explore-page-intent.mutations.mjs",
    "test:transcript-schema-adapter": "node scripts/transcript-schema-adapter.test.mjs",
    "test:transcript-schema-adapter:mutations": "node scripts/transcript-schema-adapter.mutations.mjs",
    "test:transcript-turn-model": "node scripts/transcript-turn-model.test.mjs",
    "test:transcript-turn-model:mutations": "node scripts/transcript-turn-model.mutations.mjs",
    "test:provider-harnesses": "node scripts/provider-harnesses.test.mjs",
    "test:provider-harnesses:mutations": "node scripts/provider-harnesses.mutations.mjs",
    "test:graph-contract-enums": "node scripts/graph-contract-enums.test.mjs",
    "test:structured-shiki": "node scripts/assert-structured-shiki.mjs",
    "test:gates": "pnpm test:structured-shiki && node scripts/gates.test.mjs",
    "test:analytics": "node src/ui/analytics/metrics.test.mjs",
    "test:mobile-layout": "node scripts/mobile-layout.test.mjs",
    "test:transcript-composite-width": "node scripts/transcript-composite-width.test.mjs",
    "test:transcript-markdown": "node scripts/transcript-markdown.test.mjs",
    "test:transcript-markdown:mutations": "node scripts/transcript-markdown.mutations.mjs",
    "lint:css": "node scripts/css-token-lint.mjs",
    "smoke:transcript": "node scripts/smoke-transcript.mjs",
    "smoke:transcript-ui": "node scripts/smoke-transcript-ui.mjs",
    "smoke:map": "node scripts/smoke-map.mjs",
    "smoke:changes": "node scripts/smoke-changes.mjs",
    "test:changes-overflow": "node scripts/changes-overflow.test.mjs",
    "shoot:manage": "node scripts/shootmanage.mjs",
    "build:lib": "pnpm test:package-provenance && pnpm test:contract && pnpm test:runtime-floor && pnpm test:code-map-state && pnpm test:code-map-ranking && pnpm test:code-map-ranking:mutations && pnpm test:code-map-ranking:bench && pnpm test:timeline-encoding-channels && pnpm test:timeline-highlight && pnpm test:code-map-interactions && pnpm test:code-map-drag-smoothness && pnpm test:code-map-wheel-zoom && pnpm test:code-map-descent-feedback && pnpm test:timeline-navigation && pnpm test:transcript-initial-position && pnpm test:transcript-initial-position:render && pnpm test:transcript-initial-position:mutations && pnpm test:explore-page-intent && pnpm test:explore-page-intent:mutations && pnpm test:gates && node src/ui/analytics/metrics.test.mjs && node scripts/mobile-layout.test.mjs && node scripts/transcript-composite-width.test.mjs && node scripts/css-token-lint.mjs && node scripts/gen-llm-artifacts.mjs && node scripts/contrast.mjs && vite build --config vite.lib.config.js && vite build --config vite.lib-css.config.js && node scripts/finalize-lib-build.mjs && tsc -p tsconfig.lib.json && node scripts/smoke-lib.mjs && node scripts/smoke-transcript.mjs && node scripts/smoke-transcript-ui.mjs && pnpm test:transcript-markdown && pnpm test:transcript-markdown:mutations && pnpm test:graph-contract-enums && pnpm test:transcript-schema-adapter && pnpm test:transcript-schema-adapter:mutations && pnpm test:transcript-turn-model && pnpm test:transcript-turn-model:mutations && pnpm test:provider-harnesses && pnpm test:provider-harnesses:mutations && node scripts/smoke-map.mjs && node scripts/smoke-changes.mjs && pnpm test:changes-overflow && pnpm test:timeline-a11y && pnpm test:timeline-ghosts && pnpm test:insight-panel && node scripts/contrast.mjs --css dist/lib/tokens.css && node scripts/assert-pack-contents.mjs",
    "pack:check": "node scripts/assert-pack-contents.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "oracle:graph": "node scripts/graph-oracle.mjs",
    "oracle:graph:check": "node scripts/check-graph-oracle.mjs",
    "prepack": "pnpm build:lib",
    "build": "pnpm build:app",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:all": "pnpm build && pnpm build-storybook && rm -rf dist/storybook && cp -r storybook-static dist/storybook",
    "start": "http-server dist -p ${PORT:-3000} -a 0.0.0.0 --silent"
  },
  "dependencies": {
    "@peasant-labs/schema": "0.1.1-rc1",
    "@tanstack/react-table": "^8.21.3",
    "lucide": "^1.20.0",
    "lucide-react": "^1.18.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.8.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^6.0.2",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "yaml": "2.9.0"
  }
}
