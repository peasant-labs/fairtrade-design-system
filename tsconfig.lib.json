{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "rootDir": "src/ui",
    "outDir": "dist/lib/types",
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false
  },
  "include": [
    "src/ui/**/*.jsx",
    "src/ui/index.js",
    "src/ui/closed-value.js",
    "src/ui/groupPageRows.js",
    "src/ui/table/column-align.js",
    "src/ui/table/align-class.js",
    "src/ui/graph/index.js",
    "src/ui/commons/index.js",
    "src/ui/analytics/index.js"
  ],
  "exclude": ["src/ui/**/*.stories.jsx", "src/ui/story-frame.jsx"]
}
