{
  "name": "@peasant-labs/fairtest",
  "private": true,
  "version": "0.0.0",
  "description": "Private source-only validation core for Fairtrade mounted checks. Never published and never a runtime dependency of the published package.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "scripts": {
    "test:adapter": "node --test test/host-contract.test.mjs",
    "test:bridge-contract": "node --test test/bridge-contract.test.mjs",
    "test:capture": "node --test test/capture-cases.test.mjs test/capture-rows.test.mjs test/capture-sheet.test.mjs test/capture-build.test.mjs",
    "test:core": "node --test test/core.test.mjs test/isolation.test.mjs",
    "test:evidence": "node --test test/evidence.test.mjs test/evidence-mutations.mjs"
  }
}
