{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": ["src/ui/**/*.jsx", "src/ui/**/*.js"],
  "exclude": [
    "src/ui/**/*.stories.jsx",
    "src/ui/story-frame.jsx",
    "src/ui/**/*.test.js",
    "src/ui/**/*.test.jsx",
    "src/ui/**/*.type-test.js",
    "src/ui/**/*.type-test.jsx",
    "src/ui/**/*.spec.js",
    "src/ui/**/*.spec.jsx"
  ]
}
